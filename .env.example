# ==============================================================================
# GilPedidos - Variáveis de Ambiente
# ATENÇÃO: NUNCA coloque chaves de API, senhas ou credenciais reais neste ficheiro.
# No Google Cloud Run / Produção, configure os segredos via Google Secret Manager.
# ==============================================================================

# Chave de API do Google Gemini (Exclusiva do Backend - NUNCA expor no Frontend)
GEMINI_API_KEY=

# Porta do Servidor (Opcional, padrão 3000)
PORT=3000

# Ambiente (development | production)
NODE_ENV=development
